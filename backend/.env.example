# Required production retrieval configuration
QDRANT_URL=https://your-cluster.example.qdrant.io
QDRANT_API_KEY=replace-with-qdrant-api-key
QDRANT_EXPECTED_POINT_COUNT=115909

# Required one-shot Sarvam STT configuration
SARVAM_API_KEY=replace-with-sarvam-api-key
SARVAM_API_URL=https://api.sarvam.ai/speech-to-text

# Required only to access GET /diagnostics (the endpoint fails closed when unset)
DIAGNOSTICS_API_KEY=replace-with-diagnostics-key

# Optional realtime Sarvam endpoint; defaults to the supported production URL
SARVAM_REALTIME_URL=wss://api.sarvam.ai/speech-to-text-realtime/ws

# Optional: overall one-shot harness deadline in seconds (default: 30)
RAG_REQUEST_TIMEOUT_S=30

# Optional: project-relative path to validated deployed benchmark metadata JSON
RAG_BENCHMARK_ARTIFACT=

# Browser origins, comma-separated. No wildcard origins are accepted.
# Defaults locally to http://localhost:3000, http://127.0.0.1:3000,
# http://localhost:5173, and http://127.0.0.1:5173 when unset.
FRONTEND_ORIGINS=http://localhost:5173,http://localhost:3000
